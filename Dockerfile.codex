ARG CAGE_BASE=cage-base:latest
FROM ${CAGE_BASE}
ARG CAGE_VERSION=dev

LABEL org.opencontainers.image.source=https://github.com/Sindycate/cage
LABEL org.opencontainers.image.description="cage - Docker isolation for AI coding assistants"

# OpenSSH server is Codex-only (required for Desktop SSH target)
RUN set -eux; \
    attempt=1; \
    while :; do \
      rm -rf /var/lib/apt/lists/*; \
      if apt-get -o Acquire::Retries=5 update && \
         apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
           openssh-server; then \
        break; \
      fi; \
      if [ "$attempt" -ge 8 ]; then \
        exit 1; \
      fi; \
      attempt=$((attempt + 1)); \
      sleep $((attempt * 5)); \
    done; \
    rm -rf /var/lib/apt/lists/*

# Create user before installing Codex so npm global prefix is user-writable
# (allows Codex's built-in self-update to work without root)
RUN useradd -m -s /bin/bash codex && \
    mkdir -p /home/codex/.local/bin /home/codex/.codex /home/codex/.ssh \
             /home/codex/.npm-global && \
    chown -R codex:codex /home/codex && \
    echo "codex ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/codex

# Install Codex CLI into user-writable npm prefix so self-updates work
ENV NPM_CONFIG_PREFIX=/home/codex/.npm-global
RUN npm install -g @openai/codex && \
    chown -R codex:codex /home/codex/.npm-global && \
    chmod -R a+rwX /home/codex

COPY entrypoint-codex.sh /home/codex/entrypoint.sh
COPY cage_core /usr/local/lib/cage/cage_core
COPY codex-remote.py /usr/local/bin/codex
RUN chmod -R a+rX /usr/local/lib/cage && \
    chmod 755 /home/codex/entrypoint.sh /usr/local/bin/codex

ENV HOME=/home/codex
ENV PATH=/home/codex/.npm-global/bin:/home/codex/.local/bin:$PATH

WORKDIR /home/codex

ENTRYPOINT ["/home/codex/entrypoint.sh"]

LABEL org.opencontainers.image.version="${CAGE_VERSION}" \
      io.cage.managed="true" \
      io.cage.role="codex" \
      io.cage.version="${CAGE_VERSION}"
