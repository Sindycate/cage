#!/bin/bash
set -euo pipefail

CAGE_VERSION="0.32.3"

# Resolve the real installation root without trusting cwd or PYTHONPATH.
SOURCE="$0"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd -P)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd -P)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: Cage requires Python 3.12 or newer." >&2
    exit 2
fi
if ! python3 -I -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)'; then
    echo "ERROR: Cage requires Python 3.12 or newer." >&2
    exit 2
fi

export CAGE_INTERNAL_VERSION="$CAGE_VERSION"
exec python3 -I "$SCRIPT_DIR/cage-main.py" "$@"
