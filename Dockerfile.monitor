ARG CAGE_BASE=cage-base:latest
FROM ${CAGE_BASE}
ARG CAGE_VERSION=dev

LABEL org.opencontainers.image.source=https://github.com/Sindycate/cage
LABEL org.opencontainers.image.description="Cage's network-disabled Token Monitor collector"

RUN set -eux; \
    mkdir -p /opt/token-monitor /scan/codex/sessions /scan/codex/archived_sessions /state /out; \
    curl -fsSL --max-time 120 'https://github.com/Javis603/token-monitor/archive/refs/tags/v0.48.0.tar.gz' -o /tmp/token-monitor.tar.gz; \
    echo '019b9dede6daa9e34a306dac0e3a6f90ca25ca900a298bb5205cdbe8a25a3cda  /tmp/token-monitor.tar.gz' | sha256sum -c -; \
    tar -xzf /tmp/token-monitor.tar.gz --strip-components=1 -C /opt/token-monitor; \
    rm -f /tmp/token-monitor.tar.gz; \
    cd /opt/token-monitor; \
    npm ci --omit=dev --ignore-scripts; \
    case "$(dpkg --print-architecture)" in \
      amd64) platform=linux-x64 ;; \
      arm64) platform=linux-arm64 ;; \
      *) echo "unsupported collector architecture" >&2; exit 1 ;; \
    esac; \
    npm run ensure:tokscale -- --platform="$platform"; \
    /opt/token-monitor/node_modules/.bin/tokscale --version; \
    node --check /opt/token-monitor/src/agent/agent.js

COPY token-monitor-collector.js /usr/local/bin/cage-token-monitor-collector
RUN chmod 755 /usr/local/bin/cage-token-monitor-collector && \
    chmod -R a+rX /opt/token-monitor

ENTRYPOINT ["/usr/local/bin/cage-token-monitor-collector"]

LABEL org.opencontainers.image.version="${CAGE_VERSION}" \
      io.cage.managed="true" \
      io.cage.role="monitor" \
      io.cage.version="${CAGE_VERSION}"
