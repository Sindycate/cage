/auth.json
/.credentials.json
/.auth/
/.config/gh/
/.aws/
/.ssh/
/*.pem
/*.key
/*.p12
/*.pfx
/id_rsa
/id_ed25519
/id_ecdsa
/id_dsa
/config.local.toml
/secrets.toml
/secrets.yaml
/secrets.yml
/secrets.json

